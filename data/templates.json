        "Faq": {
          "variants": {
            "Computer RepairFaq2": {
              "subtitle": "Got Questions?",
              "title1": "Frequently Asked",
              "title2": "Questions",
              "description": "Here are quick answers to the most common questions customers ask before bringing in their devices.",
              "image": "/other/faq.webp",
              "faqs": [
                {
                  "id": "q1",
                  "question": "How long does a typical laptop repair take?",
                  "answer": "Common issues like screen replacements, SSD upgrades, battery swaps, and Windows installations are usually finished within 24 to 48 hours. Complex motherboard repairs may take 2 to 3 days."
                },
                {
                  "id": "q2",
                  "question": "Do you charge for checking my computer?",
                  "answer": "Initial problem assessment and quoting are free of charge. If you decide to proceed with the repair, we only charge for parts and labor as discussed."
                },
                {
                  "id": "q3",
                  "question": "Will my personal files and data stay safe?",
                  "answer": "Yes. We respect your privacy and never delete or alter your personal data without your permission. We also offer full data backup before any major system overhaul."
                },
                {
                  "id": "q4",
                  "question": "Do you provide a warranty on repairs and parts?",
                  "answer": "Yes. All replaced hardware parts come with manufacturer warranty (typically 3 to 12 months), and our repair labor is backed by a 30-day service guarantee."
                },
                {
                  "id": "q5",
                  "question": "Can you speed up my old slow laptop?",
                  "answer": "In 90% of cases, swapping an old mechanical hard drive with an SSD and adding more RAM makes an older laptop feel practically new, saving you the cost of buying a new one."
                }
              ]
            }
          }
        },
